<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="nsga2" name="NSGA-II">
    <mxGraphModel dx="1200" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="Datos fijos (no cambian durante la optimización)&lt;br&gt;Pares candidatos E_P y probabilidades P_ij de Splink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="Población inicial: 100 individuos&lt;br&gt;(muestreo estructurado: umbral aleatorio, cada registro apunta a un vecino)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="Evaluar cada individuo: (f1, f2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="210" width="280" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="5" value="Una generación (se repite hasta agotar 20,000 evaluaciones, unas 200 generaciones)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="190" y="280" width="380" height="540" as="geometry"/>
        </mxCell>

        <mxCell id="6" value="1. Selección de padres&lt;br&gt;torneos binarios: gana el de menor rango; si empatan, el de mayor crowding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="320" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="2. Cruza uniforme (prob. 0.9)&lt;br&gt;cada gen viene de uno de los dos padres al azar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="410" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="3. Mutación (en promedio 5 genes por hijo)&lt;br&gt;gen a sí mismo (prob. 0.2) o a un vecino con prob. proporcional a P + 0.05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="495" width="280" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="4. Evaluar los 100 hijos: (f1, f2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="590" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="5. Unir padres e hijos (200 individuos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="660" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="6. Ordenar y quedarse con los 100 mejores&lt;br&gt;(rango de dominancia y, dentro de un frente, crowding)&lt;br&gt;= nueva población (elitismo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="730" width="280" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="¿Se agotaron las 20,000 evaluaciones?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="850" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="Resultado: soluciones no dominadas (frente de Pareto aproximado)&lt;br&gt;Se validan después contra la verdad conocida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="990" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="14" value="&lt;b&gt;Cómo se evalúa un individuo&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Vector de genes G: cada registro apunta a un vecino o a sí mismo&lt;br&gt;2. Se forman las aristas y se toman las componentes conexas (clusters)&lt;br&gt;3. n_C = pares dentro de clusters; ETP = suma de P_ij de los pares de E_P en el mismo cluster&lt;br&gt;4. f1 = (n_C − ETP) / n_C (FDR esperado)&lt;br&gt;5. f2 = (suma de P − ETP) / suma de P (FNR esperado)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="340" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;Criterios de orden&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rango: frente 1 = soluciones que ninguna otra domina; frente 2 = las que quedan al quitar el 1; etc. Menor rango es mejor.&lt;br&gt;&lt;br&gt;Crowding: prefiere la solución con menos vecinas cercanas en (f1, f2), para repartir el frente." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="690" width="340" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="4" target="6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="No: nueva generación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="150" y="900"/>
              <mxPoint x="150" y="350"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="4" target="14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="11" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
